# Copie para .env e preencha. O .env não é versionado.

# PostgreSQL (o Flyway cria o schema "report" se ele não existir)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seniorinsight
DB_USERNAME=report
DB_PASSWORD=

# RabbitMQ (o serviço declara a exchange topic "si.events", a fila "report.q" e a dead-letter "report.q.dlq")
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=report
RABBITMQ_PASSWORD=

# Keycloak: precisa ser igual ao claim "iss" dos tokens
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/seniorinsight
# Opcional: de onde baixar as chaves públicas, quando o issuer não é acessível pelo serviço (ex.: dentro do Compose)
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWKSETURI=http://keycloak:8080/realms/seniorinsight/protocol/openid-connect/certs

# Armazenamento de objetos (minio local; em produção, Cloud Storage)
ARMAZENAMENTO_PROVEDOR=minio
ARMAZENAMENTO_BUCKET=si-reports
MINIO_ENDPOINT=http://localhost:9000
# Endereço usado nas URLs assinadas; padrão = MINIO_ENDPOINT
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Spring Scheduler dos relatórios (false em produção: o gatilho é o Cloud Scheduler)
REPORT_AGENDAMENTO_HABILITADO=true

# Porta HTTP do serviço
SERVER_PORT=8080
